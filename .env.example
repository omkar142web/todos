# Copy to .env and fill in
PORT=3000
# NODE_ENV=development
NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
# Local dev default: ./data/focus.db
# Production with a persistent disk (e.g. Render): DATABASE_PATH=/data/focus.db
# Online DB (Supabase/Postgres — REQUIRED on Vercel, recommended on Render/Railway):
# DATABASE_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-xxx.pooler.supabase.com:6543/postgres
# (Turso also supported instead: TURSO_DATABASE_URL + TURSO_AUTH_TOKEN)
DATABASE_PATH=./data/focus.db
# Comma-separated origins for cross-origin dev (same-origin needs nothing).
# Example: CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:3000
CORS_ORIGINS=
